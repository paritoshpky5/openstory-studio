# Database configuration (SQLite Local-first)
DATABASE_URL="file:./dev.db"

# Local Data Directory (relative to project root or absolute)
OPENSTORY_DATA_DIR="./data"
STORYFLOW_DATA_DIR="./data"

# AI Story Planning & Character Decomposition (Optional - Free Web Mode available)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# AI Director quality review (optional)
# Gemini sends sampled scene frames to Google's API only after an explicit review click.
AI_DIRECTOR_GEMINI_MODEL="gemini-2.5-flash"
# Ollama keeps visual review local. Install a vision-capable model first.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_VISION_MODEL="qwen3-vl:8b"

# Image Generation API Keys
BFL_API_KEY=""

# Video Generation API Keys
KLING_API_KEY=""
KLING_API_SECRET=""
SEEDANCE_API_KEY=""
GROK_API_KEY=""

# Audio / Voice API Keys (Optional - Free Web import mode available)
SARVAM_API_KEY=""
ELEVENLABS_API_KEY=""

# Lip Sync API Keys (Optional - Local FFmpeg fallback is built-in)
SYNCLABS_API_KEY=""

# Note: All API keys above are 100% OPTIONAL.
# OpenStory Studio supports a complete $0 Free Web Workflow where you can
# copy prompts directly into Kling Web, Google ImageFX, or Sarvam and upload the files.
